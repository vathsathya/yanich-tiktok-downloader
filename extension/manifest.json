{
  "manifest_version": 3,
  "name": "TikTok Drama 1-Click Downloader Bridge",
  "version": "1.3.0",
  "description": "1-Click Send TikTok drama episodes directly to your local Desktop App.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "http://127.0.0.1:54321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TikTok Drama Downloader Bridge"
  }
}

